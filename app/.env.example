NLI_MAX_INPUT_CHARS=2400
EMBEDDING_MAX_INPUT_CHARS=2400
NLI_MAX_OUTPUT_TOKENS=64
NORMALIZATION_MAX_OUTPUT_TOKENS=512
SCORING_MAX_OUTPUT_TOKENS=256

# Redis Stack vector cache
